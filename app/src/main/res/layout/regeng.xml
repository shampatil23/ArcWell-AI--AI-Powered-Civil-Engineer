<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8FC">

    <!-- Top Gradient Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_regeng"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_toolbar_gradient"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Register as Engineer"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_regeng">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Information Banner -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#EFF6FF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏗️"
                        android:textSize="20sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="Join the Expert Network"
                            android:textColor="#1E40AF"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Register your credentials and expertise to connect with homeowners seeking floor plans and construction guidance."
                            android:textColor="#3B82F6"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Form Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <!-- Name Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Your Full Name"
                        android:textColor="#172033"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etOptionTitlee"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:drawableStart="@drawable/baseline_person_outline_24"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/primary_blue"
                        android:fontFamily="sans-serif"
                        android:hint="e.g. Er. Rajesh Sharma"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="16dp"
                        android:textColor="#172033"
                        android:textColorHint="#94A3B8"
                        android:textSize="14sp" />

                    <!-- Phone Number -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Contact Number"
                        android:textColor="#172033"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/number"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:drawableStart="@drawable/baseline_send_24"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/primary_blue"
                        android:fontFamily="sans-serif"
                        android:hint="e.g. 9876543210"
                        android:inputType="phone"
                        android:paddingHorizontal="16dp"
                        android:textColor="#172033"
                        android:textColorHint="#94A3B8"
                        android:textSize="14sp" />

                    <!-- Email Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Email Address"
                        android:textColor="#172033"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/emaile"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:drawableStart="@drawable/baseline_mail_outline_24"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/primary_blue"
                        android:fontFamily="sans-serif"
                        android:hint="your.email@example.com"
                        android:inputType="textEmailAddress"
                        android:paddingHorizontal="16dp"
                        android:textColor="#172033"
                        android:textColorHint="#94A3B8"
                        android:textSize="14sp" />

                    <!-- Skills Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Key Skills &amp; Specialization"
                        android:textColor="#172033"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/skille"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:drawableStart="@drawable/ic_sample_plans"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/primary_blue"
                        android:fontFamily="sans-serif"
                        android:hint="e.g. Structural Design, 3D Elevation, Vastu"
                        android:inputType="text"
                        android:paddingHorizontal="16dp"
                        android:textColor="#172033"
                        android:textColorHint="#94A3B8"
                        android:textSize="14sp" />

                    <!-- Experience Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Professional Experience"
                        android:textColor="#172033"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/expe"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:drawableStart="@drawable/ic_material_layer"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/primary_blue"
                        android:fontFamily="sans-serif"
                        android:hint="e.g. 8+ Years in Residential Construction"
                        android:inputType="text"
                        android:paddingHorizontal="16dp"
                        android:textColor="#172033"
                        android:textColorHint="#94A3B8"
                        android:textSize="14sp" />

                    <!-- Description Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Bio &amp; Consultation Summary"
                        android:textColor="#172033"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etOptionDescriptione"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:fontFamily="sans-serif"
                        android:gravity="top|start"
                        android:hint="Introduce yourself, your degrees, certifications, and project background..."
                        android:inputType="textMultiLine"
                        android:minHeight="90dp"
                        android:padding="16dp"
                        android:textColor="#172033"
                        android:textColorHint="#94A3B8"
                        android:textSize="14sp" />

                    <!-- Submit Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddOptione"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="4dp"
                        android:backgroundTint="@color/primary_blue"
                        android:elevation="4dp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.02"
                        android:text="Submit Registration"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        app:cornerRadius="16dp"
                        app:rippleColor="#BBDEFB" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>