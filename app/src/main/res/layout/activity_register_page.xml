<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_gradient"
    tools:context=".register_page">

    <!-- Top Header -->
    <LinearLayout
        android:id="@+id/reg_header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="36dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/register_logo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/paper_plane"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/textView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.02"
            android:text="Create Account"
            android:textColor="@color/white"
            android:textSize="28sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="Join ArcWell AI to start designing"
            android:textColor="#93C5FD"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Elevated Registration Form Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="28dp"
        app:cardElevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reg_header_layout">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Full Name Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="User Name"
                    android:textColor="#172033"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/editTextText"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:drawableStart="@drawable/baseline_person_outline_24"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/primary_blue"
                    android:fontFamily="sans-serif"
                    android:hint="Enter your name"
                    android:inputType="textPersonName"
                    android:paddingHorizontal="16dp"
                    android:textColor="#172033"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp" />

                <!-- Email Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Email Address"
                    android:textColor="#172033"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/editTextText2"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:drawableStart="@drawable/baseline_mail_outline_24"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/primary_blue"
                    android:fontFamily="sans-serif"
                    android:hint="name@example.com"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="16dp"
                    android:textColor="#172033"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp" />

                <!-- Password Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Password"
                    android:textColor="#172033"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/editTextText3"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:drawableStart="@drawable/baseline_lock_24"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/primary_blue"
                    android:fontFamily="sans-serif"
                    android:hint="Choose a secure password"
                    android:inputType="textPassword"
                    android:paddingHorizontal="16dp"
                    android:textColor="#172033"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp" />

                <!-- Phone Number Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Phone Number"
                    android:textColor="#172033"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/editTextText4"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:drawableStart="@drawable/baseline_person_outline_24"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/primary_blue"
                    android:fontFamily="sans-serif"
                    android:hint="+91 98765 43210"
                    android:inputType="phone"
                    android:paddingHorizontal="16dp"
                    android:textColor="#172033"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp" />

                <!-- Country Dropdown -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Country"
                    android:textColor="#172033"
                    android:textSize="13sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:paddingHorizontal="12dp">

                    <Spinner
                        android:id="@+id/spinner"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>

                <!-- Submit Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button2"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"
                    android:backgroundTint="@color/primary_blue"
                    android:elevation="4dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.02"
                    android:text="Create Account"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    app:cornerRadius="16dp"
                    app:rippleColor="#BBDEFB" />

            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>