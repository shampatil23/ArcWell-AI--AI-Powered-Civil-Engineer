<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8FC">

    <!-- Top Gradient Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_register_engineer"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_toolbar_gradient"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Register Engineer"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_register_engineer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Information Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#EFF6FF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏗️"
                        android:textSize="22sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="Engineer Intake Form"
                            android:textColor="#1E40AF"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif"
                            android:text="Onboard qualified architects and civil engineers into the Firestore database."
                            android:textColor="#3B82F6"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Main Input Form Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <!-- Engineer Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Full Name"
                        android:textColor="#172033"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etName"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:drawableStart="@drawable/baseline_person_outline_24"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/primary_blue"
                        android:fontFamily="sans-serif"
                        android:hint="e.g. Er. Sarah Jenkins"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="16dp"
                        android:textColor="#172033"
                        android:textColorHint="#94A3B8"
                        android:textSize="14sp" />

                    <!-- Short Description -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Short Description / Title"
                        android:textColor="#172033"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etShortDescription"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:drawableStart="@drawable/baseline_info_24"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/primary_blue"
                        android:fontFamily="sans-serif"
                        android:hint="e.g. Senior Structural Specialist"
                        android:inputType="text"
                        android:paddingHorizontal="16dp"
                        android:textColor="#172033"
                        android:textColorHint="#94A3B8"
                        android:textSize="14sp" />

                    <!-- Email -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Email Address"
                        android:textColor="#172033"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:drawableStart="@drawable/baseline_mail_outline_24"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/primary_blue"
                        android:fontFamily="sans-serif"
                        android:hint="e.g. sarah.jenkins@arcwell.io"
                        android:inputType="textEmailAddress"
                        android:paddingHorizontal="16dp"
                        android:textColor="#172033"
                        android:textColorHint="#94A3B8"
                        android:textSize="14sp" />

                    <!-- Skills -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Skills &amp; Expertise"
                        android:textColor="#172033"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etSkills"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:drawableStart="@drawable/baseline_settings_24"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/primary_blue"
                        android:fontFamily="sans-serif"
                        android:hint="e.g. AutoCAD, Revit, Structural Analysis"
                        android:inputType="text"
                        android:paddingHorizontal="16dp"
                        android:textColor="#172033"
                        android:textColorHint="#94A3B8"
                        android:textSize="14sp" />

                    <!-- Experience -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Years of Experience"
                        android:textColor="#172033"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etExperience"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:drawableStart="@drawable/baseline_admin_panel_settings_24"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/primary_blue"
                        android:fontFamily="sans-serif"
                        android:hint="e.g. 8 Years"
                        android:inputType="number"
                        android:paddingHorizontal="16dp"
                        android:textColor="#172033"
                        android:textColorHint="#94A3B8"
                        android:textSize="14sp" />

                    <!-- Submit Button -->
                    <Button
                        android:id="@+id/btnRegister"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_btn_primary_gradient"
                        android:elevation="4dp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.04"
                        android:stateListAnimator="@anim/button_state_animator"
                        android:text="REGISTER ENGINEER"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        app:backgroundTint="@null" />

                    <!-- Progress Indicator -->
                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        android:indeterminateTint="@color/primary_blue"
                        android:visibility="gone" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
