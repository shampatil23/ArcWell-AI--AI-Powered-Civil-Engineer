<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/btn_gradient"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".contacttool">

    <TextView
        android:layout_marginTop="30dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SHAM PATIL :"
        android:textSize="22dp"
        android:fontFamily="sans-serif-black"
        android:layout_gravity="center" />

    <!-- Phone Section with Icon -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true"
        android:id="@+id/phoneLayout">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@android:drawable/ic_menu_call"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/txtPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone No: 9529811731"
            android:textSize="20dp"
            android:textColor="#073C4E"/>
    </LinearLayout>

    <!-- Email Section with Icon -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true"
        android:id="@+id/emailLayout">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@android:drawable/ic_dialog_email"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/txtEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email: shampatil7275@gmail.com"
            android:textSize="20dp"
            android:textColor="#053140"/>
    </LinearLayout>

</LinearLayout>
